# ---- API (apps/api) ----
PORT=4000
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
DATABASE_PATH=./data/portfolio.db
CORS_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Web (apps/web) ----
